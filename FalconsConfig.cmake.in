@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@Falcons_USE_SYSTEM_ZSTD@)
    find_dependency(PkgConfig)
    pkg_search_module(ZSTD REQUIRED IMPORTED_TARGET libzstd)
endif()
if(@OpenMP_CXX_FOUND@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@GSL_FOUND@)
    find_dependency(GSL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/FalconsTargets.cmake")
check_required_components(Falcons)
